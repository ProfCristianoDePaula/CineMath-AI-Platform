# Choose cloudflare (Workers AI) or gemini.
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Required only when AI_PROVIDER=gemini.
# GEMINI_API_KEY=

# Required for catalog, ratings, certifications, and Brazilian provider availability.
# Prefer a TMDB API Read Access Token; TMDB_API_KEY is supported as an alternative.
TMDB_ACCESS_TOKEN=replace-with-your-tmdb-read-access-token
# TMDB_API_KEY=replace-with-your-tmdb-api-key

# Optional. Defaults to gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash

# Optional runtime settings.
# PORT=3000
# CINEMATCH_DATA_DIR=./data
