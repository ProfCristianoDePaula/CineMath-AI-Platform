# Required for AI conversation and recommendation explanations.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Required for catalog, ratings, certifications, and Brazilian provider availability.
# Get a key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=replace-with-your-tmdb-api-key

# Optional. Defaults to gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash

# Optional runtime settings.
# PORT=3000
# CINEMATCH_DATA_DIR=./data
